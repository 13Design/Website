# Supabase — public frontend values used by the two inquiry forms.
# The anon key is safe to expose in the browser; row-level security allows
# anonymous INSERT only (no read-back). Copy this file to .env.local for local
# dev, and set the same two variables in Netlify
# (Site configuration → Environment variables) for production.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
