# Supabase — used by the frontend (Vite exposes VITE_* vars to the browser).
# The anon key is public by design; row-level security protects the tables.
# Copy this file to .env.local for local dev, and set the same two vars in
# your Netlify site (Site settings → Environment variables) for production.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Paddle Billing — all four are public client-side values (the client token is
# designed to ship in the browser; secret keys live only in Supabase secrets).
# Set the same four in Netlify for production. env: sandbox | production
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_your-client-side-token
VITE_PADDLE_PRICE_LITE=pri_lite-800-per-month
VITE_PADDLE_PRICE_STANDARD=pri_standard-2500-per-month
